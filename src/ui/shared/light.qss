QLabel {
    color: black;
    font-size: 14px;
}

QLineEdit {
    color: white;
    background-color: #2b2b2b;
    border: 1px solid #444444;
    border-radius: 4px;
    font-size: 14px;
    padding: 6px;
}

QPushButton {
    background-color: #e0e0e0;
    border-radius: 4px;
    color: black;
    padding: 6px 14px;
}

QPushButton:hover {
    background-color: #d5d5d5;
}

QPushButton:pressed {
    background-color: #c8c8c8;
    padding: 4px 12px;
}